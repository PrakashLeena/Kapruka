{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/chat",        "destination": "/api/index.js" },
    { "source": "/chat/stream", "destination": "/api/index.js" },
    { "source": "/chat/image-search", "destination": "/api/index.js" },
    { "source": "/health",      "destination": "/api/index.js" },
    { "source": "/warmup",      "destination": "/api/index.js" },
    { "source": "/debug-mcp",   "destination": "/api/index.js" },
    { "source": "/chats",       "destination": "/api/index.js" },
    { "source": "/chats/migrate", "destination": "/api/index.js" },
    { "source": "/chats/:id",   "destination": "/api/index.js" },
    { "source": "/api/speech/synthesize", "destination": "/api/index.js" },
    { "source": "/api/speech/transcribe", "destination": "/api/index.js" },
    { "source": "/(.*)",        "destination": "/index.html"   }
  ],
  "crons": [
    {
      "path": "/warmup",
      "schedule": "*/5 * * * *"
    }
  ]
}
