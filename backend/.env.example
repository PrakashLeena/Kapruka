# ─── Main LLM & Vision: Google Gemini (Sole AI Provider) ─────────────────────
# Powers chat completions, streaming, tool calling, and image search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN=https://kapruka-w3vd.vercel.app/,https://www.kaprukaai.tech

# ─── Kapruka MCP server ───────────────────────────────────────────────────────
KAPRUKA_MCP_URL=https://mcp.kapruka.com/mcp

# ─── MongoDB for persistent chat history ──────────────────────────────────────
MONGODB_URI=

# ─── Azure Speech Service (Optional TTS) ──────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
